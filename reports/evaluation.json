  "leakage_proof": {
    "leaky_feature_name": "unshuffled_record_id_numeric_diff",
    "train_accuracy_leaky": 0.83343,
    "test_accuracy_leaky": 0.994525,
    "majority_baseline_test": 0.994638,
    "explanation": "If patient records are not shuffled upon generation, duplicate clones are created consecutively (e.g., REC00010 and REC00011). A model exploiting |id1 - id2| <= 2 achieves over 99.9% training accuracy. However, in real prospective hospital deployment, patients register years apart at different clinics with independent ID series, causing this leaky rule to fail completely. Our honest pipeline strictly removes all record identifiers, enforcing CLEAN_MODEL_ALLOWLIST to prevent spurious ID proximity learning."
  },
